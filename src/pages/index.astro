---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const lessons = (await getCollection('lessons')).sort((a, b) => a.data.level - b.data.level || a.data.order - b.data.order);
const levels = [
  { level: 1, title: 'Foundations' },
  { level: 2, title: 'Intermediate' },
  { level: 3, title: 'Advanced' },
].map((l) => ({ ...l, items: lessons.filter((x) => x.data.level === l.level) }));
let n = 0;
---
<Base title="System Design">
  <header class="hero">
    <p class="kicker">// system design, visual</p>
    <h1>System Design</h1>
    <p class="summary">Learn how systems work by watching them run. Follow the path from the top.</p>
    <div class="meter" data-progress>
      <p class="kicker"><span data-count>0</span> / {lessons.length} lessons done</p>
      <div class="bar" role="progressbar" aria-label="Lessons done" aria-valuemin="0" aria-valuemax={lessons.length} aria-valuenow="0"><span></span></div>
    </div>
  </header>
  {levels.map((l) => (
    <section class="level" data-level={l.level} data-slugs={l.items.map((x) => x.id).join(',')}>
      <h2><span class="kicker">Level {l.level}</span> {l.title}<span class="badge">Level complete</span></h2>
      {l.items.length === 0 ? <p class="summary">Coming soon.</p> : (
        <ol class="lessons path">
          {l.items.map((x) => (
            <li class="stop">
              <span class="pip" aria-hidden="true"><span class="num">{++n}</span><span class="check">✓</span></span>
              <div>
                <a data-lesson-link data-slug={x.id} href={`/lessons/${x.id}`}>{x.data.title}<span class="sr-done"> (done)</span></a>
                <span class="here">Start here</span>
                {x.data.poke && <span class="tag">Try it</span>}
                <p class="summary">{x.data.summary}</p>
              </div>
            </li>
          ))}
          <li class="stop quiz-stop">
            <span class="pip" aria-hidden="true"><span class="num">?</span><span class="check">✓</span></span>
            <div>
              <a data-quiz-link href={`/quiz/${l.level}`}>Level {l.level} quiz</a>
              <span class="tag" data-best>Not taken</span>
              <p class="summary">5 questions, pass with 4. Finish the level by passing it.</p>
              <p class="summary ready">All lessons done. Pass the quiz to finish this level.</p>
            </div>
          </li>
        </ol>
      )}
    </section>
  ))}
</Base>

<script>
  import { initProgress } from '../scripts/progress-dom';
  initProgress(document);
</script>
